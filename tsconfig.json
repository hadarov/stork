{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    "//": "Node's built-in type stripper only erases; it cannot compile enums, namespaces or parameter properties.",
    "erasableSyntaxOnly": true,

    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "scripts"]
}
